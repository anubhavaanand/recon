# RECON API Keys
# Copy this file to .env and fill in your keys.
# Leave blank for keyless/default scraper mode.

# Optional: USPTO Open Data Portal
USPTO_API_KEY=

# Optional: EPO Open Patent Services (OAuth 2.0)
EPO_CONSUMER_KEY=
EPO_CONSUMER_SECRET=

# Optional: Lens.org
LENS_API_KEY=

# Optional: PatSnap / Eureka Open Platform
PATSNAP_API_KEY=

# Optional: AI translation / synthesis
DEEPSEEK_API_KEY=
NVIDIA_NIM_API_KEY=
